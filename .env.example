# Enables /admin (gallery uploads). Leave unset to keep the admin switched off.
ADMIN_PASSWORD=choose-a-long-password
# Any long random string, used to sign the admin session cookie.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
# Optional: where uploaded photos are stored. Use a persistent disk in production.
# GALLERY_DIR=/var/data/maihar-gallery
